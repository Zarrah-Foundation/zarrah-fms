# Copy to .env and fill in real values. Never commit .env.

SECRET_KEY=change-me-to-a-long-random-string-at-least-40-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000
CSRF_TRUSTED_ORIGINS=

# Set USE_SQLITE=True to run locally without PostgreSQL.
USE_SQLITE=False

DB_NAME=zarrah_foundation
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=True
SMTP_USE_SSL=False

SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=True
SSLCOMMERZ_SALT_KEY=
SSLCOMMERZ_RECURRING_PLAN_REFER=

ADMIN_EMAIL=admin@example.com

# Production HTTPS toggles (defaults tighten when DEBUG=False)
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True
# ALLOW_MOCK_AUTOPAY_WHEN_DEBUG_FALSE=False
